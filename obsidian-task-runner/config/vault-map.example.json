{
  "_comment": "复制为 vault-map.json 后修改。vault-map.json 不会被 git 跟踪。",
  "obsidian_vault": "/home/you/Obsidian/MainVault",
  "projects": [
    {
      "name": "example-project",
      "path": "/home/you/src/example-project",
      "git_remote": "github.com/you/example-project"
    }
  ],
  "new_project_root": "/home/you/src",
  "models": {
    "_comment": "assignee → OMP 模型标识。通过 dev/null 禁用模型。",
    "deepseek": "deepseek/deepseek-v4-flash",
    "gpt":      "gateway/gpt-5.6-sol:xhigh",
    "default":  "deepseek/deepseek-v4-flash",
    "gemini":   "google/gemini-2.5-pro",
    "claude":   "anthropic/claude-sonnet-4-20250514",
    "minimax":  "minimax/minimax-m1"
  },
  "fallback_models": {
    "gpt": "deepseek/deepseek-v4-flash",
    "default": "deepseek/deepseek-v4-flash",
    "deepseek": "deepseek/deepseek-v4-flash"
  },
  "notifications": {
    "desktop": true,
    "sound": false
  },
  "poll_interval_minutes": 30,
  "max_concurrent_tasks": 2,
  "phase_concurrency": {
    "_comment": "非 implementing 阶段的 OMP 并发上限（0/缺省 = 不限）；round2 由 max_concurrent_tasks 控制。限制同时运行的 OMP 会话，保护 API 限速/token 消耗与本地资源。",
    "refining": 3,
    "planning": 2,
    "merge": 1,
    "priority": 1,
    "pm": 1
  }
}
