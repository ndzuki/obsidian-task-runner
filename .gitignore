# vault-map.json contains local paths — never commit real one
config/vault-map.json

# Python
__pycache__/
*.pyc

# Logs
*.log

# Go build output（根目录二进制；锚定 / 避免误伤 cmd/kitty-grill/ 目录）
/otg
/kitty-grill
coverage.out
coverage.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Core dumps
core.*
core.[0-9]*
models/

# local Go build caches (sandbox has no writable ~/.cache)
.cache/

# local scratch / test reference assets (never commit)
tmp/
tools/*
# 例外：isocity98 不是草稿 —— 它是 Agent Town 面板的资产生成器（等距预渲染管线），
# 同时也是那个可直接运行的复古等距城市沙盒。产物在 deploy/dsh-plugins/agent-monitor.html，
# 源码必须随仓库走，否则「产物可改、源不可维护」。
!tools/isocity98/
