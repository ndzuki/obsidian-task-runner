{
  "version": 2,
  "description": "Maps skill:// names to install sources. Used by skill-doctor for auto-install. 当 obsidian-task-runner 的 SKILL.md 中新增 skill:// 引用时，必须同步更新此文件。skill-doctor check 会在安装后自动提示缺失依赖。",
  "_maintenance": "此文件随 obsidian-task-runner 仓库发布。本项目的阶段 Skill 标记为 bundled（随包安装）。外部依赖需要用户通过 skill-doctor install 手动获取。2026-09-24 清理：移除已退役/未安装且无 skill:// 引用的条目（otg 9 个阶段子技能、knowledge-base、requirement-elaborator、test-quality、research、wayfinder、to-spec，以及只含未安装 skill 的 vercel-labs/skills、akin-ozer/cc-devops-skills 两个来源）。",
  "sources": {
    "obsidian-task-runner (external required)": {
      "type": "local-required",
      "description": "核心依赖 Skill，缺失时任务无法执行。请通过 ~/.dsh/skills/ 手动安装或从对应仓库获取。",
      "skills": [
        "grilling",
        "domain-modeling",
        "diagnosing-bugs",
        "tdd",
        "prototype"
      ]
    },
    "samber/cc-skills-golang": {
      "type": "github",
      "url": "https://github.com/samber/cc-skills-golang.git",
      "skillBasePath": "skills",
      "patterns": [
        "golang-*"
      ],
      "skills": [
        "golang-benchmark",
        "golang-cli",
        "golang-code-style",
        "golang-concurrency",
        "golang-context",
        "golang-continuous-integration",
        "golang-data-structures",
        "golang-database",
        "golang-dependency-management",
        "golang-design-patterns",
        "golang-documentation",
        "golang-error-handling",
        "golang-gopls",
        "golang-how-to",
        "golang-lint",
        "golang-modernize",
        "golang-naming",
        "golang-observability",
        "golang-project-layout",
        "golang-refactoring",
        "golang-safety",
        "golang-security",
        "golang-spf13-cobra",
        "golang-stretchr-testify",
        "golang-structs-interfaces",
        "golang-testing",
        "golang-troubleshooting"
      ]
    },
    "mattpocock/skills": {
      "type": "github",
      "url": "https://github.com/mattpocock/skills.git",
      "skillBasePath": "skills",
      "skills": [
        "codebase-design"
      ]
    }
  }
}